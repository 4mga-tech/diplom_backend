      "type": "text",
      "title": "Үндсэн ойлголт",
      "order": 1,
      "content": {
        "textMn": "Эгшиг зохицох ёс гэдэг нь үгийн доторх эгшгүүд нэг төрлийн өнгө аястай байхыг хэлнэ.",
        "textEn": "Vowel harmony means vowels inside a word usually belong to the same vowel group."
      }
    },
    {
      "id": "b1-u2-l1-c2",
      "lessonId": "b1-u2-l1",
      "type": "grammar_note",
      "title": "Дүрэм",
      "order": 2,
      "content": {
        "notes": [
          {"mn": "Эр эгшигтэй үгэнд ихэвчлэн эр эгшиг орно.", "en": "Words with back vowels usually keep back vowels."},
          {"mn": "Эм эгшигтэй үгэнд ихэвчлэн эм эгшиг орно.", "en": "Words with front vowels usually keep front vowels."},
          {"mn": "И нь саармаг эгшиг тул аль ч бүлэгтэй хамт орж болно.", "en": "И is neutral and can appear with either group."}
        ]
      }
    },
    {
      "id": "b1-u2-l1-c3",
      "lessonId": "b1-u2-l1",
      "type": "classification",
      "title": "Ангилал",
      "order": 3,
      "content": {
        "groups": [
          {"title": "Эр эгшигтэй үг / Back vowel words", "items": ["аав", "ном", "ус", "сургууль"]},
          {"title": "Эм эгшигтэй үг / Front vowel words", "items": ["ээж", "гэр", "сүү", "үс"]},
          {"title": "Саармаг И орсон үг / Words with neutral И", "items": ["би", "чи", "багшийн", "номын"]}
        ]
      }
