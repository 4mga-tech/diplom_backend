            "text": "ямаа",
            "transcription": "yamaa",
            "audioUrl": "/uploads/audio/words/goat.mp3",
            "call": "Я = ya",
            "instructionMn": "ямаа үгэнд Я үсэг ya гэж эхэлж байгааг давтаарай.",
            "instructionEn": "Repeat how Я begins with ya in ямаа."
          },
          {
            "text": "сайн",
            "transcription": "sain",
            "audioUrl": "/uploads/audio/words/good.mp3",
            "call": "Й = short y",
            "instructionMn": "сайн үгэнд Й нь ай хос авианы богино y шиг сонсогдоно.",
            "instructionEn": "In сайн, Й works like a short y glide in the ай sound."
          },
          {
            "text": "-ын",
            "transcription": "-iin / -yn",
            "audioUrl": "/uploads/audio/words/yn-ending.mp3",
            "call": "Ы = hard i",
            "instructionMn": "-ын төгсгөлд Ы үсгийг таньж сур. Энэ нь үгийн эхэнд ховор хэрэглэгдэнэ.",
            "instructionEn": "Recognize Ы in the ending -ын. It is rare at the beginning of words."
          }
        ],
        "instructionMn": "Одоо туслах эгшгийг дангаар нь биш, үг болон богино хэлбэр дотор сонсож танья.",
        "instructionEn": "Now recognize supporting vowels inside real words and short forms."
      }
