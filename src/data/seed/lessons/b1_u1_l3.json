  "contents": [
    {
      "id": "b1-u1-l3-c1",
      "lessonId": "b1-u1-l3",
      "type": "text",
      "title": "Гийгүүлэгч гэж юу вэ?",
      "order": 1,
      "content": {
        "textMn": "Гийгүүлэгч үсэг дангаараа уншихад богино, тод сонсогдоно. Харин эгшигтэй нийлбэл үе болно. Жишээ нь: Б + А = БА.",
        "textEn": "A consonant has a short sound by itself. When it joins with a vowel, it becomes a readable syllable. For example: Б + А = БА."
      }
    },
    {
      "id": "b1-u1-l3-c2",
      "lessonId": "b1-u1-l3",
      "type": "grammar_note",
      "title": "Гийгүүлэгч + эгшиг = үе",
      "order": 2,
      "content": {
        "textMn": "Энэ хичээлээр эхлээд гийгүүлэгчийг эгшигтэй нийлүүлж үе бүтээнэ. Дараа нь тэр үеэс богино үг уншиж сурна.",
        "textEn": "In this lesson, you first combine consonants with vowels to build syllables. Then you use those syllables to read short words."
      }
    },
    {
      "id": "b1-u1-l3-c3",
      "lessonId": "b1-u1-l3",
      "type": "exercise_word_build",
      "title": "Үе бүтээх",
      "order": 3,
      "content": {
        "instructionMn": "Гийгүүлэгч ба эгшгийг нийлүүлж үе бүтээ. Дараа нь дууг сонсоод чангаар давтаарай.",
        "instructionEn": "Combine a consonant and a vowel to build a syllable. Then listen and repeat aloud.",
        "items": [
          {
            "left": "б",
            "right": "а",
            "result": "ба",
