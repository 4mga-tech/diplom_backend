  "contents": [
    {
      "id": "b1-u1-l3-c1",
      "lessonId": "b1-u1-l3",
      "type": "text",
      "title": "Тайлбар",
      "order": 1,
      "content": {
        "textMn": "Гийгүүлэгчийг эгшигтэй нийлүүлэхэд уншиж болох үе гарна: Б + А = БА. Дараа нь үе, үсгүүдийг нийлүүлж НОМ, БАГ зэрэг богино үг уншина.",
        "textEn": "When a consonant joins a vowel, you get a readable syllable: Б + А = БА. Then you combine syllables and letters to read short words such as НОМ and БАГ."
      }
    },
    {
      "id": "b1-u1-l3-c2",
      "lessonId": "b1-u1-l3",
      "type": "grammar_note",
      "title": "Гийгүүлэгч ба үе",
      "order": 2,
      "content": {
        "textMn": "Дан гийгүүлэгчийг удаан дуудах гэж бүү оролд. Эгшиг нэмээд шууд үе болгон унш: б + а = ба, м + о = мо, с + у = су.",
        "textEn": "Do not try to stretch a consonant by itself. Add a vowel and read it as a syllable: b + a = ba, m + o = mo, s + u = su."
      }
    },
    {
      "id": "b1-u1-l3-c3",
      "lessonId": "b1-u1-l3",
      "type": "exercise_word_build",
      "title": "Гийгүүлэгч + эгшиг",
      "order": 3,
      "content": {
        "instructionMn": "Зүүн талын гийгүүлэгчийг баруун талын эгшигтэй нийлүүлээд чангаар унш.",
        "instructionEn": "Join the consonant on the left with the vowel on the right and read it aloud.",
        "items": [
          {
            "left": "Б",
            "right": "А",
            "result": "БА",
            "transcription": "ba",
