      "content": {
        "summary": "Төлөөний үгийг утгаар нь ялгаарай.",
        "groups": [
          {
            "title": "Ганц хүн",
            "description": "One person",
            "items": [
              "би = I",
              "чи = you",
              "тэр = he/she/that person",
              "та = you (polite)"
            ]
          },
          {
            "title": "Олон хүн",
            "description": "More than one person",
            "items": [
              "бид = we"
            ]
          },
          {
            "title": "Нэр үгийг орлох",
            "description": "Replace a noun with a pronoun",
            "items": [
              "Багш уншиж байна → Тэр уншиж байна",
              "Ээж ирж байна → Тэр ирж байна"
            ]
          }
